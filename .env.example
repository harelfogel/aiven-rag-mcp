# Copy to .env to override the local defaults. All optional.
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
LOG_LEVEL=INFO

# For running integration tests from the host:
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
