# Copy to .env to override defaults. Everything is optional; the defaults run the full stack.

# Postgres (docker compose creates the database with these; the server gets DATABASE_URL from them)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432                    # published on 127.0.0.1 only, for tests from the host

# Embedding model: baked into the image at build time, so a change needs `docker compose build`
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384                     # must match the model; checked at startup against the database
EMBED_BATCH_SIZE=64

# Chunking (tokens, counted with the model's own tokenizer)
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=30

# Search
SEARCH_DEFAULT_TOP_K=5
SEARCH_MAX_TOP_K=20
SEARCH_CANDIDATES=20                  # per ranked list before fusion
RRF_K=60
HNSW_EF_SEARCH=100                    # recall vs speed; must be >= SEARCH_CANDIDATES
SEARCH_TEXT_CHARS=1200                # text per result, cut in SQL
QUERY_MAX_CHARS=1000
LIST_SOURCES_DEFAULT=25
LIST_SOURCES_MAX=100
SOURCE_URL_BASE=https://github.com/aiven/devportal/blob/main/
SOURCE_PATH_PREFIX=devportal/         # stripped from a file uri to build the GitHub link

# Ingest guards
DATA_ROOT=/data                       # the only folder `ingest kind=file` may read (./data on the host)
INGEST_MAX_BYTES=5000000              # per text, file or URL
URL_TIMEOUT_S=10
URL_MAX_REDIRECTS=3

# Operations
DB_POOL_MAX=4
DB_CONNECT_TIMEOUT_S=60               # how long startup waits for Postgres
LOG_LEVEL=INFO                        # logs go to stderr; stdout is the MCP channel

# Only for running the integration tests from the host:
# DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
